# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web Client ID from Firebase / Google Cloud Console
# Required for Google Sign-In via Credential Manager & Firebase Authentication.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# MAPBOX_PUBLIC_TOKEN: Public Access Token (pk.*) for Mapbox Streets Tile API & Mapbox Geocoding API.
# Configure this token in the Secrets panel in AI Studio.
MAPBOX_PUBLIC_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN


